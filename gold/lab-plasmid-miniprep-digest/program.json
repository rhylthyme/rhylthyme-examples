{
  "schemaVersion": "0.2.0",
  "programId": "gold-lab-plasmid-miniprep-digest",
  "name": "Plasmid Miniprep, Restriction Digest and Gel Check",
  "description": "Spin-column miniprep of an overnight culture, EcoRI/HindIII double digest with heat inactivation, and an agarose gel cast in parallel; one operator sharing a microcentrifuge, two heat blocks and one gel rig.",
  "environmentType": "laboratory",
  "actors": 1,
  "resourceConstraints": [
    {
      "task": "centrifuge",
      "maxConcurrent": 1,
      "description": "Benchtop centrifuge for 15 mL tubes"
    },
    {
      "task": "microcentrifuge",
      "maxConcurrent": 1,
      "description": "One microcentrifuge shared by the miniprep spins and the digest spin-down"
    },
    {
      "task": "bench",
      "maxConcurrent": 2,
      "description": "Bench space for pipetting and cooling"
    },
    {
      "task": "microwave",
      "maxConcurrent": 1,
      "description": "Microwave for melting agarose"
    },
    {
      "task": "heat-block-37",
      "maxConcurrent": 1,
      "description": "37 °C heat block"
    },
    {
      "task": "heat-block-65",
      "maxConcurrent": 1,
      "description": "65 °C heat block"
    },
    {
      "task": "spectrophotometer",
      "maxConcurrent": 1,
      "description": "Spectrophotometer for DNA quantification"
    },
    {
      "task": "gel-rig",
      "maxConcurrent": 1,
      "description": "Single electrophoresis rig"
    },
    {
      "task": "transilluminator",
      "maxConcurrent": 1,
      "description": "Gel imager"
    }
  ],
  "tracks": [
    {
      "trackId": "miniprep",
      "name": "Miniprep",
      "steps": [
        {
          "stepId": "pellet-culture",
          "name": "Pellet the overnight culture",
          "task": "centrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "centrifuge at 4,000 × g for 10 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "resuspend-pellet",
          "name": "Resuspend pellet",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pellet-culture"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Resuspend the pellet in 250 µL of Resuspension Buffer (with RNase A) by vortexing; about 2 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "lyse-cells",
          "name": "Alkaline lysis",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "resuspend-pellet"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "incubate at room temperature for 5 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "neutralize-and-spin",
          "name": "Neutralize and clear lysate",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "lyse-cells"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add 350 µL of Neutralization Buffer, invert 6 times, and centrifuge at maximum speed for 10 minutes in the microcentrifuge",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "bind-column",
          "name": "Bind lysate to spin column",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 60
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "neutralize-and-spin"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load the cleared lysate onto a spin column and spin for 1 minute",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "wash-column",
          "name": "Wash column",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 60
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "bind-column"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Wash the column with 700 µL of Wash Buffer, spin for 1 minute",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "dry-column",
          "name": "Dry spin",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "wash-column"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "spin the empty column for 2 minutes to dry the membrane",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "elute-dna",
          "name": "Elute plasmid",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "dry-column"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "add 50 µL of Elution Buffer, wait 1 minute, and spin for 1 minute to elute",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "quantify-dna",
          "name": "Measure concentration",
          "task": "spectrophotometer",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "elute-dna"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Measure the concentration on the spectrophotometer; 3 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "gel",
      "name": "Agarose gel",
      "steps": [
        {
          "stepId": "melt-agarose",
          "name": "Melt agarose in TAE",
          "task": "microwave",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pellet-culture",
            "event": "start"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "weigh 0.5 g of agarose into 50 mL of 1× TAE and microwave for 2 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "cool-agarose",
          "name": "Cool agarose",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "melt-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Cool the flask on the bench for 10 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "pour-gel",
          "name": "Add stain and pour gel",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cool-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "add 5 µL of DNA stain and pour the gel into the casting tray with the comb in place; 2 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "set-gel",
          "name": "Let gel set",
          "duration": {
            "type": "fixed",
            "seconds": 1800
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Let the gel set for 30 minutes at room temperature",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "place-gel",
          "name": "Place gel in rig under TAE",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "set-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "remove the comb and place the gel in the rig under 1× TAE; 2 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "prepare-ladder",
          "name": "Thaw ladder and prepare loading dye",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "incubate-digest",
            "event": "start",
            "offsetSeconds": 600
          },
          "metadata": {
            "sourceSpan": {
              "quote": "thaw the 1 kb ladder and mix 4 µL of 6× loading dye into a fresh tube for each lane; 5 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "digest",
      "name": "Restriction digest and gel run",
      "steps": [
        {
          "stepId": "warm-heat-block",
          "name": "Bring 37 °C heat block to temperature",
          "task": "heat-block-37",
          "description": "Not stated in the source; the block must be at 37 °C before the digest goes in.",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "quantify-dna"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Incubate at 37 °C for 60 minutes in the heat block",
              "occurrence": 1
            },
            "inferred": true
          }
        },
        {
          "stepId": "setup-digest",
          "name": "Assemble digest reaction",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "warm-heat-block"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "combine 500 ng of plasmid, 2 µL of 10× buffer, 0.5 µL each of EcoRI and HindIII, and water to 20 µL; 5 minutes of pipetting",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "incubate-digest",
          "name": "Incubate digest at 37 °C",
          "task": "heat-block-37",
          "duration": {
            "type": "fixed",
            "seconds": 3600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "setup-digest"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Incubate at 37 °C for 60 minutes in the heat block",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "heat-inactivate",
          "name": "Heat-inactivate at 65 °C",
          "task": "heat-block-65",
          "duration": {
            "type": "fixed",
            "seconds": 1200
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "incubate-digest"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Heat-inactivate the enzymes at 65 °C for 20 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "load-gel",
          "name": "Spin down and load gel",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "heat-inactivate"
              },
              {
                "type": "afterStep",
                "stepId": "prepare-ladder"
              },
              {
                "type": "afterStep",
                "stepId": "place-gel"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add loading dye to the digest, briefly spin down the tube in the microcentrifuge for 30 seconds, and load 10 µL per well alongside 5 µL of ladder; 5 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "run-gel",
          "name": "Run gel at 100 V",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": 2700
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run the gel at 100 V for 45 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "image-gel",
          "name": "Image gel",
          "task": "transilluminator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Image the gel on the transilluminator and record band sizes; 5 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    }
  ]
}
