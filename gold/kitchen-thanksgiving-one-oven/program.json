{
  "schemaVersion": "0.2.0",
  "programId": "gold-kitchen-thanksgiving-one-oven",
  "name": "Thanksgiving for Eight with One Oven",
  "description": "Turkey, gravy, stuffing, green bean casserole, mashed potatoes and rolls, sequenced through a single oven so everything reaches the table together at six.",
  "environmentType": "kitchen",
  "actors": 2,
  "resourceConstraints": [
    {
