      "description": "One oven; the roast and every baked side take turns"
    },
    {
      "task": "burner",
      "maxConcurrent": 4,
      "description": "Four stovetop burners"
    },
    {
      "task": "counter",
      "maxConcurrent": 2,
      "description": "Two working surfaces for prep, resting and carving"
    }
  ],
  "tracks": [
