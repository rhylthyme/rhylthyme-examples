          "duration": {
            "type": "fixed",
            "seconds": 1200
          },
          "startTrigger": {
            "type": "programStartOffset",
            "offsetSeconds": 2400
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Heat the oven to 325°F; give it 20 minutes to come up",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
