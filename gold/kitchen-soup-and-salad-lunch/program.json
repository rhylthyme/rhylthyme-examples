{
  "schemaVersion": "0.2.0",
  "programId": "gold-kitchen-soup-and-salad-lunch",
  "name": "Weekday Lentil Soup and Salad for Four",
  "description": "Lentil soup, a shaved fennel salad and warmed bread for one cook: the salad, bread and table all hang off the moment the soup goes to a simmer.",
  "environmentType": "kitchen",
  "actors": 1,
  "resourceConstraints": [
    {
      "task": "burner",
      "maxConcurrent": 2,
      "description": "Two burners; only the soup pot is ever on one"
    },
    {
      "task": "blender",
      "maxConcurrent": 1,
      "description": "One stick blender"
    },
    {
      "task": "toaster-oven",
      "maxConcurrent": 1,
      "description": "One toaster oven for the bread"
    },
    {
      "task": "counter",
      "maxConcurrent": 2,
      "description": "Counter and table space for the one cook"
    }
  ],
  "tracks": [
    {
      "trackId": "soup",
      "name": "Soup",
      "steps": [
        {
          "stepId": "dice-vegetables",
          "name": "Dice the soffritto",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Dice an onion, a carrot and two sticks of celery; 8 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "sweat-vegetables",
          "name": "Sweat the vegetables",
          "task": "burner",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "dice-vegetables"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Sweat them in oil with a bay leaf for 10 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "add-lentils",
          "name": "Add lentils, tomato paste and stock",
          "task": "burner",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "sweat-vegetables"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Stir in the rinsed lentils, a spoonful of tomato paste and a litre of stock; 3 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "simmer-lentils",
          "name": "Simmer until the lentils are soft",
          "task": "burner",
          "duration": {
            "type": "variable",
            "minSeconds": 1500,
            "maxSeconds": 2400,
            "defaultSeconds": 1800
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "add-lentils"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Simmer until the lentils are soft, 25 to 40 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "blitz-soup",
          "name": "Blitz a third of the pot",
          "task": "blender",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "simmer-lentils"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Blitz a third of the pot with the stick blender and stir it back in; 4 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "hold-soup",
          "name": "Hold at a bare simmer",
          "task": "burner",
          "duration": {
            "type": "variable",
            "minSeconds": 300,
            "maxSeconds": 1800,
            "defaultSeconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "blitz-soup"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "keep it at a bare simmer until you sit down",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "salad",
      "name": "Salad",
      "steps": [
        {
          "stepId": "wash-leaves",
          "name": "Wash and spin the leaves",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "simmer-lentils",
            "event": "start"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Wash and spin the leaves; 5 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "shave-fennel",
          "name": "Shave fennel and radishes",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 420
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "wash-leaves"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Shave the fennel and the radishes thin; 7 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "whisk-dressing",
          "name": "Whisk the dressing in the bowl",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "shave-fennel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Whisk the lemon, oil and mustard in the bottom of the bowl; 3 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "dress-salad",
          "name": "Dress and toss the salad",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStepWithBuffer",
            "stepId": "blitz-soup",
            "bufferSeconds": 300
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Five minutes after the soup goes back on the heat, dress and toss the salad; 2 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "bread",
      "name": "Bread",
      "steps": [
        {
          "stepId": "slice-bread",
          "name": "Slice the loaf",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "simmer-lentils",
            "event": "start"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Cut the loaf into thick slices once the soup is simmering; 3 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "warm-bread",
          "name": "Warm the bread",
          "task": "toaster-oven",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "slice-bread"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Warm them in the toaster oven for 8 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "wrap-bread",
          "name": "Wrap the bread in a cloth",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "warm-bread"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Wrap the warm bread in a cloth and leave it on the table",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "table",
      "name": "Table",
      "steps": [
        {
          "stepId": "lay-places",
          "name": "Lay four places",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "wrap-bread"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Lay four places once the bread is wrapped; 5 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "serve-lunch",
          "name": "Carry it through",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "hold-soup"
              },
              {
                "type": "afterStep",
                "stepId": "dress-salad"
              },
              {
                "type": "afterStep",
                "stepId": "wrap-bread"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "carry the pot and the bowl through together; 3 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    }
  ]
}
