{
  "schemaVersion": "0.2.0",
  "programId": "gold-lab-microbiology-streak-and-incubate",
  "name": "Streaking Three Cultures onto Selective Media",
  "description": "Three isolates streaked for single colonies, queued through a 37 °C incubator shelf that holds only two plates, read the next morning and followed by a supervisor-gated purity subculture and a Gram stain.",
  "environmentType": "laboratory",
  "actors": 1,
  "resourceConstraints": [
    {
      "task": "loop-station",
      "maxConcurrent": 1,
      "description": "One burner and loop; one plate streaked at a time"
    },
    {
      "task": "incubator",
      "maxConcurrent": 2,
      "description": "37 °C incubator: two plate positions on the free shelf"
    },
    {
      "task": "bench",
      "maxConcurrent": 2,
      "description": "Bench space for labelling, holding plate 3 and reading plates"
    },
    {
      "task": "stain-rack",
      "maxConcurrent": 1,
      "description": "One staining rack"
    },
    {
      "task": "microscope",
      "maxConcurrent": 1,
      "description": "One microscope with an oil-immersion objective"
    }
  ],
