{
  "schemaVersion": "0.2.0",
  "programId": "gold-lab-pcr-and-gel",
  "name": "Colony PCR Screen with a Diagnostic Gel",
  "description": "Eight colony PCRs assembled on ice, cycled in the single thermocycler, and run on an agarose gel cast and set during the cycling window; loading waits on the products, the rig and the ladder together.",
  "environmentType": "laboratory",
  "actors": 1,
  "resourceConstraints": [
    {
      "task": "ice-bucket",
      "maxConcurrent": 1,
      "description": "One ice bucket and cold block for reaction setup"
    },
    {
      "task": "microcentrifuge",
      "maxConcurrent": 1,
      "description": "One microcentrifuge shared by the setup and the product spin"
    },
    {
      "task": "thermocycler",
      "maxConcurrent": 1,
      "description": "One thermocycler; the cycling block is the long pole"
    },
    {
      "task": "microwave",
      "maxConcurrent": 1,
      "description": "Microwave for melting agarose"
    },
    {
      "task": "bench",
      "maxConcurrent": 2,
      "description": "Bench space for cooling, pouring, ladder prep and recording"
    },
    {
      "task": "gel-rig",
      "maxConcurrent": 1,
      "description": "Single electrophoresis rig"
    },
    {
      "task": "transilluminator",
      "maxConcurrent": 1,
      "description": "Gel imager"
    }
  ],
  "tracks": [
    {
      "trackId": "setup",
      "name": "Reaction setup",
      "steps": [
        {
          "stepId": "thaw-reagents",
          "name": "Thaw primers, dNTPs and buffer on ice",
          "task": "ice-bucket",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Thaw the primers, dNTPs and 10× buffer on ice; 15 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "assemble-mix",
          "name": "Assemble the master mix on ice",
          "task": "ice-bucket",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thaw-reagents"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Assemble a 25 µL master mix on ice for eight reactions plus one spare; 10 minutes of pipetting",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "aliquot-and-spin",
          "name": "Aliquot, add template and spin down",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "assemble-mix"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Aliquot 25 µL into eight strip tubes, add 1 µL of each colony suspension and spin them down for 30 seconds in the microcentrifuge; 5 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "cycling",
      "name": "Thermocycler",
      "steps": [
        {
          "stepId": "load-cycler",
          "name": "Load tubes and start the program",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "aliquot-and-spin"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load the strip tubes into the thermocycler and start the program; 3 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "run-pcr",
          "name": "Run the cycling program",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": 6600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-cycler"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "The block reports 1 hour 50 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "gel",
      "name": "Agarose gel",
      "steps": [
        {
          "stepId": "melt-agarose",
          "name": "Melt the agarose",
          "task": "microwave",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-pcr",
            "event": "start",
            "offsetSeconds": 1500
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Twenty-five minutes into the cycling run, weigh 1.0 g of agarose into 100 mL of 1× TAE and microwave for 3 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "cool-agarose",
          "name": "Cool the flask on the bench",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 720
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "melt-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Cool the flask on the bench for 12 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "pour-gel",
          "name": "Stain, pour and seat the comb",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cool-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add 5 µL of DNA stain, pour the gel into the casting tray and seat the 10-well comb; 3 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "set-gel",
          "name": "Let the gel set",
          "duration": {
            "type": "fixed",
            "seconds": 2100
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Let the gel set for 35 minutes at room temperature",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "place-gel",
          "name": "Pull the comb and place the gel in the rig",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "set-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Remove the comb and place the gel in the rig under 1× TAE; 2 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "readout",
      "name": "Run and read",
      "steps": [
        {
          "stepId": "prepare-ladder",
          "name": "Thaw and mix the ladder",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "set-gel",
            "event": "start",
            "offsetSeconds": 600
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Ten minutes after the gel is poured to set, thaw the 100 bp ladder and mix it with 6× loading dye; 5 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "spin-products",
          "name": "Spin products and add loading dye",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-pcr"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "When the cycling finishes, spin the tubes down and add 5 µL of loading dye to each; 5 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "load-gel",
          "name": "Load products and ladder",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "spin-products"
              },
              {
                "type": "afterStep",
                "stepId": "place-gel"
              },
              {
                "type": "afterStep",
                "stepId": "prepare-ladder"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load 10 µL per well alongside 5 µL of ladder; 8 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "run-gel",
          "name": "Run the gel at 120 V",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": 2400
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run the gel at 120 V for 40 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "image-gel",
          "name": "Image the gel",
          "task": "transilluminator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Image the gel on the transilluminator; 5 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "record-results",
          "name": "Record positive clones",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "image-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Record which clones carry the insert and mark the plate; 10 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    }
  ]
}
