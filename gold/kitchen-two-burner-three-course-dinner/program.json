          "task": "blender",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "simmer-soup"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "blend the soup smooth; 5 minutes",
