      "description": "Two burners",
      "actorsRequired": 1.0
    },
    {
      "task": "counter",
      "maxConcurrent": 2,
      "description": "Counter space for knife work, pastry and plating"
    },
    {
      "task": "refrigerator",
      "maxConcurrent": 1,
      "description": "One refrigerator for chilling the tart shell",
      "actorsRequired": 0.0
    },
    {
      "task": "blender",
      "maxConcurrent": 1,
      "description": "One stick blender"
    },
    {
