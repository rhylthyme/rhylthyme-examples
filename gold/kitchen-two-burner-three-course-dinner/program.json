          "startTrigger": {
            "type": "afterStep",
            "stepId": "plate-ribs"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Let the main course run as long as it runs",
              "occurrence": 1
            }
          }
        }
      ]
    },
