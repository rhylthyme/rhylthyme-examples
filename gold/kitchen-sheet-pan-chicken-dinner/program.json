{
  "schemaVersion": "0.2.0",
  "programId": "gold-kitchen-sheet-pan-chicken-dinner",
  "name": "Sheet-Pan Chicken with Potatoes and Broccoli",
  "description": "A weeknight sheet-pan dinner for four: staggered pans in one oven, a mid-roast rotate that adds the broccoli, a burner pan sauce and a salad dressed on a buffer off the chicken's rest.",
  "environmentType": "kitchen",
  "actors": 1,
  "resourceConstraints": [
    {
      "task": "oven",
      "maxConcurrent": 1,
      "description": "One oven holding both sheet pans"
    },
    {
      "task": "burner",
      "maxConcurrent": 1,
      "description": "One burner for the pan sauce"
    },
    {
      "task": "counter",
      "maxConcurrent": 2,
      "description": "Counter and board space for prep, the pan swap and plating"
    }
  ],
  "tracks": [
    {
      "trackId": "prep",
      "name": "Prep",
      "steps": [
        {
          "stepId": "toss-potatoes",
          "name": "Toss the potatoes on the first pan",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "toss the halved potatoes with oil and salt on the first sheet pan; 8 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "season-chicken",
          "name": "Season the thighs on the second pan",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "toss-potatoes"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Pat the chicken thighs dry, rub them with the spice mix and lay them on the second pan; 10 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "oven",
      "name": "Oven",
      "steps": [
        {
          "stepId": "preheat-oven",
          "name": "Preheat the oven to 425°F",
          "task": "oven",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Heat the oven to 425°F; 15 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "roast-potatoes",
          "name": "Roast the potatoes alone",
          "task": "oven",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "preheat-oven"
              },
              {
                "type": "afterStep",
                "stepId": "toss-potatoes"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Slide the potatoes in and roast them for 15 minutes on their own",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "roast-chicken",
          "name": "Roast the chicken alongside",
          "task": "oven",
          "duration": {
            "type": "fixed",
            "seconds": 1200
          },
          "startTrigger": {
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "roast-potatoes"
              },
              {
                "type": "afterStep",
                "stepId": "season-chicken"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Put the second pan in when the potatoes have had their 15 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "swap-pans",
          "name": "Rotate the pans and add the broccoli",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "roast-chicken",
            "event": "start",
            "offsetSeconds": 1200
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Twenty minutes after the chicken goes in, pull both pans out, rotate them, tip the broccoli onto the potato pan and put everything back; 4 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "final-roast",
          "name": "Final roast",
          "task": "oven",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "swap-pans"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Roast for a final 15 minutes, until the thighs read 175°F and the broccoli is charred at the edges",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "rest-chicken",
          "name": "Rest the chicken",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "final-roast"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Rest the chicken on a board for 8 minutes before slicing",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "sauce",
      "name": "Pan sauce",
      "steps": [
        {
          "stepId": "reduce-sauce",
          "name": "Reduce the pan juices",
          "task": "burner",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "final-roast"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "tip the pan juices into a small pan, add stock and mustard and reduce for 6 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "finish-butter",
          "name": "Whisk in cold butter",
          "task": "burner",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "reduce-sauce"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Whisk in cold butter off the heat; 2 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "salad",
      "name": "Salad",
      "steps": [
        {
          "stepId": "wash-leaves",
          "name": "Wash and dry the leaves",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "roast-chicken",
            "event": "start"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Wash and dry the leaves; 6 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "make-vinaigrette",
          "name": "Shake the vinaigrette",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "wash-leaves"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Shake the vinaigrette together in a jar; 3 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "dress-salad",
          "name": "Dress the salad",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStepWithBuffer",
            "stepId": "rest-chicken",
            "bufferSeconds": 300,
            "event": "start"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Dress the salad only when the chicken has been resting five minutes; 2 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "serve",
      "name": "Serve",
      "steps": [
        {
          "stepId": "plate-dinner",
          "name": "Slice and plate",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "rest-chicken"
              },
              {
                "type": "afterStep",
                "stepId": "finish-butter"
              },
              {
                "type": "afterStep",
                "stepId": "dress-salad"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Slice the thighs and plate everything; 6 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    }
  ]
}
