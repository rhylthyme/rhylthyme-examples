          "task": "griddle",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Heat the griddle to 375°F; 8 minutes",
              "occurrence": 1
            }
          }
        },
