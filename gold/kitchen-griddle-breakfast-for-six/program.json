{
  "schemaVersion": "0.2.0",
  "programId": "gold-kitchen-griddle-breakfast-for-six",
  "name": "Breakfast for Six on One Griddle",
  "description": "Bacon, pancakes, scrambled eggs, toast and coffee for six from a single griddle, a two-slice toaster and an oven holding the plates warm.",
  "environmentType": "kitchen",
  "actors": 1,
  "resourceConstraints": [
    {
      "task": "griddle",
      "maxConcurrent": 1,
      "description": "One electric griddle: every hot item queues on it"
    },
    {
      "task": "toaster",
      "maxConcurrent": 1,
      "description": "Two-slice toaster"
    },
    {
      "task": "grinder",
      "maxConcurrent": 1,
      "description": "Burr grinder"
    },
    {
      "task": "coffee-maker",
      "maxConcurrent": 1,
      "description": "Drip coffee maker"
    },
    {
      "task": "oven",
      "maxConcurrent": 1,
      "description": "Oven on its lowest setting, holding plates and cooked food"
    },
    {
      "task": "counter",
      "maxConcurrent": 2,
      "description": "Counter and table space for mixing, buttering and laying up"
    }
  ],
  "tracks": [
    {
      "trackId": "prep",
      "name": "Prep",
      "steps": [
        {
          "stepId": "mix-batter",
          "name": "Mix the pancake batter",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Whisk the dry pancake ingredients together, then beat in the buttermilk and eggs; 10 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "rest-batter",
          "name": "Rest the batter",
          "duration": {
            "type": "fixed",
            "seconds": 1200
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "mix-batter"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Let the batter stand for 20 minutes while the griddle does its first job",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "crack-eggs",
          "name": "Crack and season the eggs",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "rest-batter"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Crack a dozen eggs into a jug and season them; 5 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "set-table",
          "name": "Set the table",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 600
