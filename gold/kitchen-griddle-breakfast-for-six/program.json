              "occurrence": 1
            }
          }
        },
        {
          "stepId": "toast-batch-2",
          "name": "Second batch of toast",
          "task": "toaster",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "toast-batch-1"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run a second batch straight after; 3 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "butter-toast",
          "name": "Butter the toast",
          "task": "counter",
          "duration": {
            "type": "fixed",
            "seconds": 240
