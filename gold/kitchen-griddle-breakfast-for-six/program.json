              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "the first pass takes 6 minutes",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "pancakes-pass-2",
          "name": "Pancakes, second pass",
          "task": "griddle",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pancakes-pass-1"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "the second another 6",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "pancakes-pass-3",
          "name": "Pancakes, third pass",
          "task": "griddle",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pancakes-pass-2"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "and the third 6 more",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "drop-griddle-heat",
          "name": "Drop the griddle to 300°F",
          "task": "griddle",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pancakes-pass-3"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Drop the griddle to 300°F and give it 4 minutes to settle",
              "occurrence": 1
            }
          }
        },
        {
          "stepId": "scramble-eggs",
          "name": "Scramble the eggs",
          "task": "griddle",
          "duration": {
            "type": "fixed",
            "seconds": 420
