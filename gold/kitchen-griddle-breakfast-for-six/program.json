          "startTrigger": {
            "type": "afterStep",
            "stepId": "toast-batch-2"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Butter all of it; 4 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "coffee",
      "name": "Coffee",
      "steps": [
        {
          "stepId": "grind-beans",
