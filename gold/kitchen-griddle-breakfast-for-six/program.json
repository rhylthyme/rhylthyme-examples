                "type": "afterStep",
                "stepId": "crack-eggs"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "scramble the eggs slowly for 7 minutes",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
      "trackId": "toast",
