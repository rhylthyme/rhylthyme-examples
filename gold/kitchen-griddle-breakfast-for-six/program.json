          "task": "oven",
          "duration": {
            "type": "variable",
            "minSeconds": 600,
            "maxSeconds": 3600,
            "defaultSeconds": 840
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "set-table"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Put six plates in the oven at its lowest setting and leave them there until you call everyone",
              "occurrence": 1
            }
          }
        }
      ]
    },
    {
